    "@forge/events": "^3.0.9",
    "@forge/kvs": "^2.1.1",
    "@forge/resolver": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
